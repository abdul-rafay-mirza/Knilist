{
    "app-id": "com.github.abdulrafaymirza.knilist",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "base": "io.qt.PySide.BaseApp",
    "base-version": "6.11",
    "command": "knilist",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--share=network",
        "--device=dri",
        "--filesystem=xdg-config/knilist:create",
        "--talk-name=org.freedesktop.secrets",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "modules": [
        "pypi-dependencies.json",
        {
            "name": "knilist",
            "buildsystem": "simple",
            "build-commands": [
                "pip install --no-index --no-build-isolation --prefix=/app --no-deps .",
                "install -Dm644 icon/knilist.svg /app/share/icons/hicolor/scalable/apps/com.github.abdulrafaymirza.knilist.svg",
                "install -Dm644 com.github.abdulrafaymirza.knilist.desktop /app/share/applications/com.github.abdulrafaymirza.knilist.desktop"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
